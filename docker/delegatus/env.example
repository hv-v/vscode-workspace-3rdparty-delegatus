# docker/delegatus/.env — written by `./delegatus.sh init` from this file.
# .env is git-ignored; edit it there, then `./delegatus.sh restart`.
#
# Not settable here, on purpose (pinned in docker-compose.yml): telemetry,
# DO_NOT_TRACK and the in-container port.

# Host user the container runs as; must be able to read the transcript folders.
DELEGATUS_UID=1000
DELEGATUS_GID=1000

# Published on 127.0.0.1 only.
DELEGATUS_HOST_PORT=8898

# Agent transcripts shown as chats, mounted read-only. Absolute host paths.
DELEGATUS_CLAUDE_TRANSCRIPTS=/home/user/.claude/projects
DELEGATUS_CODEX_TRANSCRIPTS=/home/user/.codex/sessions

# The workspace, mounted read-only at the same path. Absolute host path.
DELEGATUS_WORKSPACE=/home/user/jo-workspace

# Container memory ceiling.
DELEGATUS_MEM_LIMIT=4g

# Interface/CLI language: en or uk.
DELEGATUS_LANG=en
