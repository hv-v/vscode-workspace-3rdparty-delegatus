{
  "permissions": {
    "deny": [
      "Read(**/.atlassian/.secrets/credentials)",
      "Read(**/.atlassian/.secrets/certs/**)",
      "WebFetch(domain:jira-sms.group.jenoptik.corp)",
      "WebFetch(domain:confluence-sms.group.jenoptik.corp)",
      "Read(**/.gitlab/.secrets/credentials)",
      "Read(**/.gitlab/.secrets/certs/**)",
      "WebFetch(domain:as-git-01.jenoptik.corp)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'h=\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/graph-status.sh\"; [ -x \"$h\" ] && exec \"$h\" || exit 0'",
            "timeout": 12,
            "statusMessage": "Checking code graph coverage"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -c 'if env.JO_VERIFY_PROMPT == \"1\" and ((.prompt // \"\") | length) >= 80 then {hookSpecificOutput:{hookEventName:\"UserPromptSubmit\",additionalContext:\"Before acting on this prompt, follow .claude/skills/common/a-verify-prompt/SKILL.md - read it by path, it is grouped and so not in the skill roster. If the result differs from what the user wrote, show the verified prompt plus the REWRITTEN lines and get explicit approval before doing any work. If it is RETURNED, relay the questions and stop.\"}} else empty end'",
            "timeout": 5,
            "statusMessage": "Queueing prompt verification"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'h=\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/graph-first.sh\"; [ -x \"$h\" ] && exec \"$h\" || exit 0'",
            "timeout": 5,
            "statusMessage": "Checking graph-first rule"
          }
        ]
      },
      {
        "matcher": "Bash|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'h=\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/corp-guard.sh\"; [ -x \"$h\" ] && exec \"$h\" || exit 0'",
            "timeout": 5,
            "statusMessage": "Checking corporate-host access rule"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'h=\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard-generated.sh\"; [ -x \"$h\" ] && exec \"$h\" || exit 0'",
            "timeout": 5,
            "statusMessage": "Checking generated-file guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'h=\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/clang-format.sh\"; [ -x \"$h\" ] && exec \"$h\" || exit 0'",
            "timeout": 15,
            "statusMessage": "clang-format"
          }
        ]
      }
    ]
  }
}
