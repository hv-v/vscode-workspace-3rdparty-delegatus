# Copy, don't edit:  install -m 600 credentials.example credentials
# KEY=VALUE per line. Everything after the first '=' is the value.
# Your GitLab login, the one you use in the browser:
GITLAB_USER=your.username
GITLAB_PASSWORD=your-password-here
# Or, if you can ever create one, a personal token with read_api only;
# it replaces the two lines above:
# GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
