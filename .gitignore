# untracked dependencies

*.patch

# workspace projects specific

3rdparty/

# Atlassian mirror: pulled corporate content stays on this machine (.atlassian/README.md)
/.atlassian/.confluence/
/.atlassian/.db/
/.atlassian/.jira/
/.atlassian/.cache/
/.atlassian/navigation_map.md
# Only the placeholders in .secrets are tracked; the real credentials and certs never are.
/.atlassian/.secrets/*
!/.atlassian/.secrets/README.md
!/.atlassian/.secrets/credentials.example
!/.atlassian/.secrets/certs/
/.atlassian/.secrets/certs/*
!/.atlassian/.secrets/certs/.gitkeep

# GitLab mirror: MRs, threads and job logs stay on this machine (.gitlab/README.md)
/.gitlab/.mr/
/.gitlab/.logs/
/.gitlab/.cache/
/.gitlab/navigation_map.md
/.gitlab/.secrets/*
!/.gitlab/.secrets/README.md
!/.gitlab/.secrets/credentials.example
!/.gitlab/.secrets/certs/
/.gitlab/.secrets/certs/*
!/.gitlab/.secrets/certs/.gitkeep

# Antigravity conversation data, if a session writes it under the workspace
/.gemini/
