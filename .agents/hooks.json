{
  "graph-status": {
    "SessionStart": [
      { "type": "command", "command": "./hooks/claude-hook.sh graph-status", "timeout": 12 }
    ]
  },
  "graph-first": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          { "type": "command", "command": "./hooks/claude-hook.sh graph-first", "timeout": 5 }
        ]
      }
    ]
  },
  "corp-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command|read_url_content|view_file|write_to_file|replace_file_content|multi_replace_file_content|code_action",
        "hooks": [
          { "type": "command", "command": "./hooks/claude-hook.sh corp-guard", "timeout": 5 }
        ]
      }
    ]
  },
  "guard-generated": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|code_action",
        "hooks": [
          { "type": "command", "command": "./hooks/claude-hook.sh guard-generated", "timeout": 5 }
        ]
      }
    ]
  },
  "clang-format": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|code_action",
        "hooks": [
          { "type": "command", "command": "./hooks/claude-hook.sh clang-format", "timeout": 15 }
        ]
      }
    ]
  }
}
